# 階段 0 不需要這些設定也能安全執行。本機使用時可將此檔案複製為 .env。
APP_ENV=development
LOG_LEVEL=INFO

# 後續階段啟用 Discord 整合前必須提供以下設定。
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
# 必須是允許頻道的子集合；留空時所有白名單頻道都是 normal。
DISCORD_COMPANION_CHANNEL_IDS=
DISCORD_OWNER_USER_ID=
DISCORD_ADMIN_USER_IDS=
DISCORD_AI_COMMAND_PREFIX=!s

# SQLite 資料庫預設保存在不受 Git 追蹤的 data 目錄。
DATABASE_URL=sqlite+aiosqlite:///data/discord_assistant.db

# 無明確回覆時，同一作者可續接唯一活動段落的時間窗。
CONVERSATION_IMPLICIT_CONTINUATION_MINUTES=5

# 陪伴模式只在頻道安靜滿 5 秒後評估；自動回覆成功後預設冷卻 120 秒。
COMPANION_OBSERVATION_SECONDS=5
COMPANION_COOLDOWN_SECONDS=120
COMPANION_ACTIVITY_WINDOW_SECONDS=60
COMPANION_RECENT_BOT_MINUTES=10

# 留空時明確觸發只回固定維護訊息，不會產生付費呼叫。
OPENAI_API_KEY=
AI_PERSONA_PATH=personas/salt-zh-tw-v1.toml
AI_CHAT_MODEL=gpt-5.6-luna
AI_CHAT_PRICE_VERSION=openai-2026-08-03
AI_CHAT_INPUT_MICROUSD_PER_MILLION_TOKENS=1000000
AI_CHAT_OUTPUT_MICROUSD_PER_MILLION_TOKENS=6000000
AI_CHAT_MAX_CONTEXT_CHARACTERS=12000
AI_RECENT_PARTICIPANT_CONTEXT_MINUTES=5
AI_RECENT_MESSAGES_PER_PARTICIPANT=4
AI_RECENT_PARTICIPANT_CONTEXT_CHARACTERS=2000
AI_MAX_MENTIONED_PARTICIPANTS=3
AI_PERSONAL_MEMORY_CONTEXT_CHARACTERS=1500
AI_CHAT_MAX_OUTPUT_TOKENS=800
AI_CHAT_REASONING_EFFORT=low
AI_MAINTENANCE_MESSAGE=目前 AI 回覆暫時無法使用，請稍後再試。

# 階段 5 預設關閉；改成 true 後才處理「之後新封存」的段落並產生費用。
BACKGROUND_AI_ENABLED=false
AI_SUMMARY_MODEL=gpt-5.4-nano-2026-03-17
AI_SUMMARY_PRICE_VERSION=openai-2026-08-04
AI_SUMMARY_INPUT_MICROUSD_PER_MILLION_TOKENS=200000
AI_SUMMARY_OUTPUT_MICROUSD_PER_MILLION_TOKENS=1250000
AI_SUMMARY_MAX_OUTPUT_TOKENS=300
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_PRICE_VERSION=openai-2026-08-04
AI_EMBEDDING_INPUT_MICROUSD_PER_MILLION_TOKENS=20000
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_CHUNK_CHARACTERS=2000
AI_EMBEDDING_CHUNK_OVERLAP_CHARACTERS=200
AI_HISTORY_RESULT_LIMIT=3
AI_HISTORY_CONTEXT_CHARACTERS=3000
BACKGROUND_JOB_INTERVAL_MINUTES=5
BACKGROUND_JOB_HIGH_WATER_MARK=20
BACKGROUND_JOB_MAX_PER_RUN=10
BACKGROUND_JOB_MAX_ATTEMPTS=5
BACKGROUND_JOB_RETRY_BASE_SECONDS=60
BACKGROUND_JOB_BUDGET_RETRY_MINUTES=5
BACKGROUND_JOB_STALE_MINUTES=5
